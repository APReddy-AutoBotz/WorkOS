#!/usr/bin/env bash
set -euo pipefail

EVIDENCE_DIR=/tmp/wos01a-evidence
mkdir -p "$EVIDENCE_DIR"

log() {
  printf '[WOS-01A] %s\n' "$*"
}

log 'verifying publisher and branch leases'
test "$GITHUB_REF_NAME" = 'controller/wos01a-auth-convergence-publisher-20260830'
git merge-base --is-ancestor "$BASE_HEAD" HEAD
expected_trigger_paths="$(cat <<'PATHS' | LC_ALL=C sort
.github/controller/wos01a-auth-convergence.patch.br.b64.part00
.github/controller/wos01a-auth-convergence.patch.br.b64.part01
.github/controller/wos01a-auth-convergence.patch.br.b64.part02
.github/controller/wos01a-auth-convergence.patch.br.b64.part03
.github/controller/wos01a-auth-convergence-validator.sh.part00
.github/controller/wos01a-auth-convergence-validator.sh.part01
.github/workflows/wos01a-auth-convergence-publisher.yml
PATHS
)"
actual_trigger_paths="$(git diff --name-only "$BASE_HEAD" HEAD | LC_ALL=C sort)"
test "$actual_trigger_paths" = "$expected_trigger_paths"
remote_product="$(git ls-remote origin "refs/heads/$PRODUCT_BRANCH" | cut -f1)"
test "$remote_product" = "$BASE_HEAD"
remote_validation="$(git ls-remote origin "refs/heads/$VALIDATION_BRANCH" | cut -f1)"
test "$remote_validation" = "$BASE_HEAD"

log 'recovering exact hash-bound correction'
cat "${RECOVERY_PREFIX}"* > /tmp/wos01a.patch.br.b64
base64 -d /tmp/wos01a.patch.br.b64 > /tmp/wos01a.patch.br
echo "$PATCH_COMPRESSED_SHA256  /tmp/wos01a.patch.br" | sha256sum -c -
test "$(wc -c < /tmp/wos01a.patch.br | tr -d '[:space:]')" = "$PATCH_COMPRESSED_BYTES"
node - <<'NODE'
const fs = require('fs');
const zlib = require('zlib');
fs.writeFileSync('/tmp/wos01a.patch', zlib.brotliDecompressSync(fs.readFileSync('/tmp/wos01a.patch.br')));
NODE
echo "$PATCH_SHA256  /tmp/wos01a.patch" | sha256sum -c -
test "$(wc -c < /tmp/wos01a.patch | tr -d '[:space:]')" = "$PATCH_BYTES"

log 'applying correction to exact WOS-01A product authority'
git reset --hard "$BASE_HEAD"
git clean -ffdx
test "$(git rev-parse HEAD)" = "$BASE_HEAD"
test "$(git rev-parse HEAD^{tree})" = "$BASE_TREE"
git apply --check /tmp/wos01a.patch
git apply --index /tmp/wos01a.patch
expected_product_paths="$(cat <<'PATHS' | LC_ALL=C sort
.env.example
package.json
scripts/scan-bootstrap.mjs
server/authorization-policy.mjs
server/index.mjs
server/migrations/010_workforce_os_integrations.sql
server/migrations/015_notification_graph_teams_templates.sql
server/migrations/021_authorization_convergence.sql
server/product-metadata.mjs
server/schema.sql
server/seed-demo.mjs
tests/authorization-convergence-integration.mjs
tests/authorization-convergence-smoke.mjs
tests/production-identity-smoke.mjs
PATHS
)"
actual_product_paths="$(git diff --cached --name-only | LC_ALL=C sort)"
test "$actual_product_paths" = "$expected_product_paths"
git diff --cached --check
git config user.name 'WorkOS Authorization Convergence Controller'
git config user.email 'actions@users.noreply.github.com'
git commit -m 'fix: converge WOS-01A authorization controls'
CORRECTION_HEAD="$(git rev-parse HEAD)"
CORRECTION_TREE="$(git rev-parse HEAD^{tree})"
test "$(git rev-parse HEAD^)" = "$BASE_HEAD"
test -z "$(git status --porcelain)"
printf '%s\n' "$CORRECTION_HEAD" > "$EVIDENCE_DIR/correction-head.txt"
printf '%s\n' "$CORRECTION_TREE" > "$EVIDENCE_DIR/correction-tree.txt"
git diff --name-status "$BASE_HEAD" HEAD > "$EVIDENCE_DIR/changed-files.txt"
git diff --stat "$BASE_HEAD" HEAD > "$EVIDENCE_DIR/diff-stat.txt"

log 'installing locked dependencies without lifecycle scripts'
npm ci --ignore-scripts 2>&1 | tee "$EVIDENCE_DIR/npm-ci.txt"

log 'running retained static, type, lint, test and build gates'
{
  npm run test:wos00-baseline
  npm run test:bootstrap-scan
  npm run test:authorization-convergence
  npm run typecheck
  npm run lint
  npm test
  npm run build
  test ! -e dist/index.html || ! grep -q '%VITE_' dist/index.html
} 2>&1 | tee "$EVIDENCE_DIR/static-and-build-gates.txt"

log 'proving runtime dependency disposition'
set +e
npm audit --omit=dev --json > "$EVIDENCE_DIR/runtime-audit.json"
audit_status=$?
set -e
test "$audit_status" -le 1
node - <<'NODE' | tee "$EVIDENCE_DIR/runtime-audit-summary.json"
const fs = require('fs');
const report = JSON.parse(fs.readFileSync('/tmp/wos01a-evidence/runtime-audit.json', 'utf8'));
const vulnerabilities = report.metadata?.vulnerabilities;
if (!vulnerabilities) process.exit(1);
if (Number(vulnerabilities.high || 0) > 0 || Number(vulnerabilities.critical || 0) > 0) {
  console.error(JSON.stringify(vulnerabilities));
  process.exit(1);
}
console.log(JSON.stringify({status: 'passed', vulnerabilities}, null, 2));
NODE

log 'running fresh, replay and authorization integration database gates'
{
  npm run api:migrate
  npm run api:migrate
  npm run test:authorization-convergence-integration
  psql "$DATABASE_URL" -v ON_ERROR_STOP=1 -Atc "select count(*) from entra_group_role_mappings where group_id like 'mock-entra-group-%'" | grep -qx '0'
  psql "$DATABASE_URL" -v ON_ERROR_STOP=1 -Atc "select count(*) from information_schema.tables where table_name = 'entra_auth_transactions'" | grep -qx '1'
} 2>&1 | tee "$EVIDENCE_DIR/database-and-authorization-gates.txt"

log 'running production identity browser-binding and replay acceptance'
{
  createdb -h 127.0.0.1 -U postgres workos_identity
  identity_url='postgresql://postgres:postgres@127.0.0.1:5432/workos_identity'
  DATABASE_URL="$identity_url" npm run api:migrate
  DATABA