SE_URL="$identity_url" npm run test:production-identity
} 2>&1 | tee "$EVIDENCE_DIR/production-identity-gates.txt"

log 'proving upgrade-shaped schema ordering and governed defaults'
createdb -h 127.0.0.1 -U postgres workos_upgrade
upgrade_url='postgresql://postgres:postgres@127.0.0.1:5432/workos_upgrade'
psql "$upgrade_url" -v ON_ERROR_STOP=1 <<'SQL'
create extension if not exists "pgcrypto";
create table roles (
  id uuid primary key default gen_random_uuid(),
  name text not null unique
);
create table users (
  id uuid primary key default gen_random_uuid(),
  username text not null unique,
  employee_id text unique,
  email text not null unique,
  password_hash text,
  status text not null default 'Active',
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);
create table country_directors (
  id text primary key,
  name text not null,
  region text not null
);
create table employees (
  id text primary key,
  employee_id text not null unique,
  name text not null,
  email text not null unique,
  designation text not null,
  department text not null,
  country text not null,
  primary_country_director_id text not null references country_directors(id),
  status text not null,
  expected_weekly_hours numeric,
  notes text,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);
create table audit_logs (
  id uuid primary key default gen_random_uuid(),
  user_id text not null,
  user_name text not null,
  user_role text not null,
  module text not null,
  action text not null,
  entity_type text,
  entity_id text,
  old_value jsonb,
  new_value jsonb,
  reason text,
  details text not null,
  created_at timestamptz not null default now()
);
SQL
DATABASE_URL="$upgrade_url" npm run api:migrate 2>&1 | tee "$EVIDENCE_DIR/upgrade-migration.txt"
psql "$upgrade_url" -v ON_ERROR_STOP=1 -At <<'SQL' > "$EVIDENCE_DIR/upgrade-assertions.txt"
select count(*) from information_schema.columns where table_name = 'employees' and column_name in ('teams_user_id','entra_object_id','reporting_manager_id');
select count(*) from pg_indexes where indexname in ('idx_employees_teams_user_id','idx_employees_entra_object_id','idx_employees_reporting_manager');
select count(*) from entra_group_role_mappings where group_id like 'mock-entra-group-%';
select count(*) from notification_templates where body like '%Configured product%';
select count(*) from notification_templates where body like '%{{productName}}%';
SQL
mapfile -t assertions < "$EVIDENCE_DIR/upgrade-assertions.txt"
test "${assertions[0]}" = '3'
test "${assertions[1]}" = '3'
test "${assertions[2]}" = '0'
test "${assertions[3]}" = '0'
test "${assertions[4]}" = '4'

log 'recording exact validation authority'
AUTH_BASE_HEAD="$BASE_HEAD" \
AUTH_BASE_TREE="$BASE_TREE" \
AUTH_CORRECTION_HEAD="$CORRECTION_HEAD" \
AUTH_CORRECTION_TREE="$CORRECTION_TREE" \
AUTH_PATCH_SHA256="$PATCH_SHA256" \
AUTH_PATCH_COMPRESSED_SHA256="$PATCH_COMPRESSED_SHA256" \
AUTH_VALIDATION_BRANCH="$VALIDATION_BRANCH" \
node - <<'NODE'
const fs = require('fs');
const authority = {
  status: 'passed',
  baseHead: process.env.AUTH_BASE_HEAD,
  baseTree: process.env.AUTH_BASE_TREE,
  correctionHead: process.env.AUTH_CORRECTION_HEAD,
  correctionTree: process.env.AUTH_CORRECTION_TREE,
  patchSha256: process.env.AUTH_PATCH_SHA256,
  patchCompressedSha256: process.env.AUTH_PATCH_COMPRESSED_SHA256,
  validationBranch: process.env.AUTH_VALIDATION_BRANCH,
};
fs.writeFileSync('/tmp/wos01a-evidence/authority.json', JSON.stringify(authority, null, 2) + '\n');
console.log(JSON.stringify(authority));
NODE

log 'publishing isolated validated head under exact lease'
remote_product="$(git ls-remote origin "refs/heads/$PRODUCT_BRANCH" | cut -f1)"
test "$remote_product" = "$BASE_HEAD"
remote_validation="$(git ls-remote origin "refs/heads/$VALIDATION_BRANCH" | cut -f1)"
test "$remote_validation" = "$BASE_HEAD"
git push --force-with-lease="refs/heads/$VALIDATION_BRANCH:$BASE_HEAD" origin "HEAD:refs/heads/$VALIDATION_BRANCH"
test "$(git ls-remote origin "refs/heads/$VALIDATION_BRANCH" | cut -f1)" = "$CORRECTION_HEAD"
log "validated correction published to quarantine: $CORRECTION_HEAD"
