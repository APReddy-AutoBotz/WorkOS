{
  "name": "workos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "api:dev": "node server/index.mjs",
    "api:migrate": "node server/migrate.mjs",
    "api:seed:demo": "node server/seed-demo.mjs",
    "build": "vite build",
    "start": "node server/start-production.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "node scripts/lint.mjs",
    "test:requirements": "node --import tsx tests/requirements-smoke.mjs",
    "test:access": "node --import tsx tests/access-control-smoke.mjs",
    "test:ess": "node --import tsx tests/ess-hub-smoke.mjs",
    "test:leave": "node --import tsx tests/leave-management-smoke.mjs",
    "test:backend": "node tests/backend-contract-smoke.mjs",
    "test:approvals": "node --import tsx tests/approval-engine-smoke.mjs",
    "test:notifications": "node --import tsx tests/notification-center-smoke.mjs",
    "test:integrations": "node --import tsx tests/integration-adapters-smoke.mjs",
    "test:microsoft-live": "node tests/microsoft-live-config-smoke.mjs",
    "test:planning": "node --import tsx tests/resource-planning-smoke.mjs",
    "test:phase7-scope": "node tests/phase7-scope-smoke.mjs",
    "test:audit-governance": "node tests/audit-governance-smoke.mjs",
    "test:operations-readiness": "node tests/operations-readiness-smoke.mjs",
    "test:credential-handover": "node tests/credential-handover-smoke.mjs",
    "test:real-data-cutover": "node --import tsx tests/real-data-cutover-smoke.mjs",
    "test:org-chart": "node --import tsx tests/org-chart-smoke.mjs",
    "test:permissions": "node --import tsx tests/dynamic-permissions-smoke.mjs",
    "test:browser-ux": "node tests/browser-ux-smoke.cjs",
    "test:import-templates": "node tests/import-template-smoke.mjs",
    "test:production-identity": "node tests/production-identity-smoke.mjs",
    "test:identity-discovery": "node tests/identity-discovery-smoke.mjs",
    "test:authorization-convergence": "node tests/authorization-convergence-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "test:wos00-baseline": "node scripts/verify-baseline.mjs",
    "test:bootstrap-scan": "node scripts/scan-bootstrap.mjs",
    "test:document-metadata": "node tests/document-metadata-smoke.mjs",
    "test": "npm run test:requirements && npm run test:access && npm run test:ess && npm run test:leave && npm run test:backend && npm run test:approvals && npm run test:notifications && npm run test:integrations && npm run test:planning && npm run test:phase7-scope && npm run test:org-chart && npm run test:permissions && npm run test:import-templates && npm run test:document-metadata && npm run test:identity-discovery"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.20.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "7.18.2",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@babel/compat-data": "^7.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "description": "Buyer-owned professional-services operations platform"
}
