# Copy this file to .env.production and replace every placeholder before use.
# Keep this file limited to placeholders; never commit real credentials.
NODE_ENV=production
APP_MODE=production
APP_URL=https://workos.example.test
APP_BIND_ADDRESS=127.0.0.1
APP_BIND_PORT=4000
DATABASE_URL=postgresql://workos:replace_me@db:5432/workos
POSTGRES_DB=workos
POSTGRES_USER=workos
POSTGRES_PASSWORD=replace_me
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_BIND_PORT=5432
PGSSLMODE=disable
# External database: require or verify-full validates both trust and hostname.
# Mount the CA read-only into both application and migration containers.
PGSSLROOTCERT=
API_SESSION_SECRET=replace_with_a_unique_random_secret_at_least_32_characters
IDENTITY_PROVIDER=entra
ENTRA_TENANT_ID=replace_me
ENTRA_CLIENT_ID=replace_me
ENTRA_CLIENT_SECRET=replace_me
ENTRA_REDIRECT_URI=https://workos.example.test/api/auth/entra/callback
AUTO_SEED_DEMO=false
RESET_DEMO_DATA=false
ALLOW_TEST_FALLBACK=false
VITE_ALLOW_TEST_FALLBACK=false
BUILD_SHA=unknown

LOGIN_RATE_LIMIT=8
LOGIN_IP_RATE_LIMIT=64
# Empty means direct peers only. Set explicit reverse-proxy IPs/CIDRs, comma-separated.
TRUSTED_PROXY_CIDRS=
